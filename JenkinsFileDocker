pipeline 
{
    agent any
    tools
    {
        maven 'Maven_3.9.9'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('git checkout')
        {
            steps()
            git branch: 'DevOpsFebruary2026', url: 'https://github.com/vidyagowda-110/Maven-Web-Application.git'
        }
        stage('Build Project')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }
        stage('Build Docker Image')
        {
            steps()
            {
                sh 'docker build -t vidyashreekgowda/homepage-service:${buildNumber} .'
            }
        }



    }
}
