pipeline 
{
    agent any
    tools
    {
        maven 'Maven_3.9.9'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('git checkout')
        {
            steps
            {
            git branch: 'DevOpsFebruary2026', url: 'https://github.com/vidyagowda-110/Maven-Web-Application.git'
            }
        }
        stage('Build Project')
        {
            steps
            {
                sh 'mvn clean package'
            }
        }
        stage('Build Docker Image')
        {
            steps
            {
                sh 'docker build -t vidyashreekgowda/homepage-service:${buildNumber} .'
            }
        }
        stage('push docker image to dockerhub')
        {
            steps
            {
                withCredentials([string(credentialsId: 'docker_hub_pass', variable: 'docker_hub_pass')]) 
                {
                    sh 'docker login -u vidyashreekgowda -p ${docker_hub_pass}'
                }
                sh 'docker push vidyashreekgowda/homepage-service:${buildNumber}'
                
            }
        }
        stage('delete the image locally')
        {
            steps
            {
                sh 'docker rmi -f vidyashreekgowda/homepage-service:${buildNumber}'
            }
        }
        stage('deploy application to docker')
        { 
            steps
            {
                sshagent(credentials: ['deployment_id'])
                {
                   sh "ssh -o strictlyHostKeyChecking=no ubuntu@172.31.11.6 docker rm -f maven_container || true"
                   sh "ssh -o strictlyHostKeyChecking=no ubuntu@172.31.11.6 docker run -d -name maven_container -p 8080:8080 vidyashreekgowda/homepage-service:${buildNumber}"
                }
            }
        }
    }
}




    